diff --git a/test/static_machine_test.zig b/test/static_machine_test.zig
index 22f4ca4..4217f67 100644
--- a/test/static_machine_test.zig
+++ b/test/static_machine_test.zig
@@ -3075,6 +3075,136 @@ const BoundedStringMachine = boundary.staticMachine(StringProgram, .{ .maximum_s
 const WideBoundedStringMachine = boundary.staticMachine(StringProgram, .{ .maximum_state_bytes = 4096 });
 const BoundedAfterMachine = boundary.staticMachine(AfterContractProgramA, .{ .maximum_state_bytes = 2048 });
 const DebugOneEffectMachine = boundary.staticMachine(OneEffectProgram, .{ .debug_metadata = true });
+
+const performance_warmup_iterations = 2_000;
+const performance_measured_iterations = 20_000;
+const performance_sample_count = 5;
+
+fn performanceOneEffectLifecycle() !u64 {
+    const state = try OneEffectMachine.initialState(std.testing.allocator, .{});
+    defer OneEffectMachine.deinitState(state);
+    var fuel: u64 = 100;
+    const request = switch (try OneEffectMachine.reduce(state, &fuel)) {
+        .request => |value| value,
+        else => return error.UnexpectedTransition,
+    };
+    const payload = try request.payload([]const u8);
+    return payload.len;
+}
+
+fn performanceDecodeLifecycle(encoded: []const u8) !u64 {
+    const state = try OneEffectMachine.decodeState(
+        std.testing.allocator,
+        encoded,
+    );
+    defer OneEffectMachine.deinitState(state);
+    const request = switch (try OneEffectMachine.current(state)) {
+        .request => |value| value,
+        else => return error.UnexpectedTransition,
+    };
+    const payload = try request.payload([]const u8);
+    return payload.len;
+}
+
+fn performanceMedian(
+    input: [performance_sample_count]u64,
+) u64 {
+    var sorted = input;
+    var index: usize = 1;
+    while (index < sorted.len) : (index += 1) {
+        const value = sorted[index];
+        var insertion = index;
+        while (insertion > 0 and sorted[insertion - 1] > value) {
+            sorted[insertion] = sorted[insertion - 1];
+            insertion -= 1;
+        }
+        sorted[insertion] = value;
+    }
+    return sorted[sorted.len / 2];
+}
+
+test "RNF performance baseline one effect lifecycle" {
+    var warmup_checksum: u64 = 0;
+    for (0..performance_warmup_iterations) |_| {
+        warmup_checksum +%= try performanceOneEffectLifecycle();
+    }
+    std.mem.doNotOptimizeAway(warmup_checksum);
+
+    var samples: [performance_sample_count]u64 = undefined;
+    var checksum: u64 = 0;
+    for (&samples) |*sample| {
+        const start = std.Io.Timestamp.now(std.testing.io, .boot);
+        for (0..performance_measured_iterations) |_| {
+            checksum +%= try performanceOneEffectLifecycle();
+        }
+        sample.* = @intCast(
+            start.durationTo(
+                std.Io.Timestamp.now(std.testing.io, .boot),
+            ).toNanoseconds(),
+        );
+    }
+
+    const state = try OneEffectMachine.initialState(std.testing.allocator, .{});
+    defer OneEffectMachine.deinitState(state);
+    var fuel: u64 = 100;
+    _ = switch (try OneEffectMachine.reduce(state, &fuel)) {
+        .request => |value| value,
+        else => return error.UnexpectedTransition,
+    };
+    const encoded = try OneEffectMachine.encodeState(std.testing.allocator, state);
+    defer std.testing.allocator.free(encoded);
+
+    var decode_warmup_checksum: u64 = 0;
+    for (0..performance_warmup_iterations) |_| {
+        decode_warmup_checksum +%= try performanceDecodeLifecycle(encoded);
+    }
+    std.mem.doNotOptimizeAway(decode_warmup_checksum);
+
+    var decode_samples: [performance_sample_count]u64 = undefined;
+    var decode_checksum: u64 = 0;
+    for (&decode_samples) |*sample| {
+        const start = std.Io.Timestamp.now(std.testing.io, .boot);
+        for (0..performance_measured_iterations) |_| {
+            decode_checksum +%= try performanceDecodeLifecycle(encoded);
+        }
+        sample.* = @intCast(
+            start.durationTo(
+                std.Io.Timestamp.now(std.testing.io, .boot),
+            ).toNanoseconds(),
+        );
+    }
+
+    const expected_checksum =
+        @as(u64, performance_measured_iterations) *
+        performance_sample_count * 7;
+    try std.testing.expectEqual(expected_checksum, checksum);
+    try std.testing.expectEqual(expected_checksum, decode_checksum);
+    std.debug.print(
+        "boundary_performance_v1 implementation=static-v0.7 state_bytes={d} " ++
+            "iterations={d} sample_ns=[{d},{d},{d},{d},{d}] " ++
+            "median_ns={d} checksum={d} " ++
+            "decode_sample_ns=[{d},{d},{d},{d},{d}] " ++
+            "decode_median_ns={d} decode_checksum={d}\n",
+        .{
+            encoded.len,
+            performance_measured_iterations,
+            samples[0],
+            samples[1],
+            samples[2],
+            samples[3],
+            samples[4],
+            performanceMedian(samples),
+            checksum,
+            decode_samples[0],
+            decode_samples[1],
+            decode_samples[2],
+            decode_samples[3],
+            decode_samples[4],
+            performanceMedian(decode_samples),
+            decode_checksum,
+        },
+    );
+}
 
